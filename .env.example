# Copy to .env (or export these in the shell). `npm run keys` can create the file for you.
# Never commit real keys. In a GitHub Codespace, store them as Codespaces secrets with the same names.

# Required: two different accounts on Studionet. The publisher needs roughly 0.3 GEN in total.
PUBLISHER_KEY=0x
WATCHER_KEY=0x

# Optional: the account that receives slashed bonds (only ever receives money; random when empty).
BENEFICIARY_KEY=

# Optional: use an existing deployment instead of deploying contracts/plumbline.py first.
PLUMBLINE_ADDRESS=

# Optional tuning: a stable public page the live run reads (it must have well over 200 characters of text).
# PAGE_URL=https://www.iana.org/help/example-domains
