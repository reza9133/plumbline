# Plumbline frontend configuration. Copy to .env.local; every value has a working default.

# The deployed Plumbline contract on GenLayer Studionet.
VITE_PLUMBLINE_ADDRESS=0x88Cda1E737d8Fb939BC4aE9F3A4Ca958d0A27d4c

# Block explorer base URL (address and transaction pages are appended).
VITE_EXPLORER_URL=https://explorer-studio.genlayer.com

# Optional: serve the app from a sub-path (for example /plumbline/ on GitHub Pages).
# VITE_BASE=/plumbline/

# Optional: another Studionet RPC endpoint.
# VITE_RPC_URL=https://studio.genlayer.com/api
